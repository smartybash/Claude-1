// =====================================================================
// NQ Confluence — three-filter system  (TradingView / Pine v5)
//   FILTER 1 LOCATION  : A+/DENSE zones (edit the Z1/Z2/Z3 inputs daily)
//   FILTER 2 DIRECTION : macro bias from the daily 10/20 SMA
//   FILTER 3 EXTENSION : session VWAP +/- sigma stretch
//   + regression channel (breakout / tap-retrace context)
//   + fade / break signals & alerts, trend-aligned only
//
// This is Pine (TradingView). For ThinkOrSwim use nq_confluence.ts (thinkScript).
// Apply to a 30-min NQ1! / MNQ1! chart. Update the ZONE inputs each morning
// from the three_filter_read output.
// =====================================================================
//@version=5
indicator("NQ Confluence — 3-filter + channel", overlay=true, max_boxes_count=50)

kStretch = input.float(0.5, "Min VWAP sigma (extension)")
chanLen  = input.int(60,   "Regression channel lookback")
chanDev  = input.float(2.0,"Channel sigma")

// ---- ZONES (edit daily): hi / lo / is-resistance ----
grpZ = "Zones (edit daily)"
z1_hi = input.float(28763, "Z1 hi", group=grpZ), z1_lo = input.float(28701, "Z1 lo", group=grpZ), z1_res = input.bool(true,  "Z1 is resistance", group=grpZ)
z2_hi = input.float(28254, "Z2 hi", group=grpZ), z2_lo = input.float(28178, "Z2 lo", group=grpZ), z2_res = input.bool(false, "Z2 is resistance", group=grpZ)
z3_hi = input.float(28111, "Z3 hi", group=grpZ), z3_lo = input.float(27990, "Z3 lo", group=grpZ), z3_res = input.bool(false, "Z3 is resistance", group=grpZ)

// ---- FILTER 2: macro DIRECTION (daily 10/20 SMA + position) ----
dClose = request.security(syminfo.tickerid, "D", close, lookahead=barmerge.lookahead_off)
sma10  = ta.sma(dClose, 10)
sma20  = ta.sma(dClose, 20)
bias   = sma10 > sma20 and dClose > sma20 ? 1 : sma10 < sma20 and dClose < sma20 ? -1 : 0

// ---- FILTER 3: session VWAP + sigma, stretch = (close-VWAP)/sigma ----
newSess = ta.change(time("D")) != 0
var float pv = na, var float vv = na, var float pv2 = na
if newSess or na(vv)
    pv  := hlc3 * volume
    vv  := volume
    pv2 := math.pow(hlc3, 2) * volume
else
    pv  += hlc3 * volume
    vv  += volume
    pv2 += math.pow(hlc3, 2) * volume
vwap    = pv / vv
variance = pv2 / vv - math.pow(vwap, 2)
sigma   = variance > 0 ? math.sqrt(variance) : 0.0
stretch = sigma > 0 ? (close - vwap) / sigma : 0.0

plot(vwap, "VWAP", color=color.aqua, linewidth=2)
plot(vwap + kStretch * sigma, "VWAP +k", color=color.new(color.gray, 55))
plot(vwap - kStretch * sigma, "VWAP -k", color=color.new(color.gray, 55))

// ---- FILTER 1: LOCATION zones (filled horizontal bands) ----
p1h = plot(z1_hi, color=na), p1l = plot(z1_lo, color=na)
p2h = plot(z2_hi, color=na), p2l = plot(z2_lo, color=na)
p3h = plot(z3_hi, color=na), p3l = plot(z3_lo, color=na)
fill(p1h, p1l, color = z1_res ? color.new(color.red, 84) : color.new(color.green, 84), title="Z1")
fill(p2h, p2l, color = z2_res ? color.new(color.red, 84) : color.new(color.green, 84), title="Z2")
fill(p3h, p3l, color = z3_res ? color.new(color.red, 84) : color.new(color.green, 84), title="Z3")

// ---- regression channel (trailing linreg + residual sigma) ----
reg  = ta.linreg(close, chanLen, 0)
rstd = ta.stdev(close - reg, chanLen)
plot(reg,               "Chan mid", color=color.purple)
plot(reg + chanDev*rstd,"Chan up",  color=color.new(color.purple, 35), style=plot.style_linebr)
plot(reg - chanDev*rstd,"Chan lo",  color=color.new(color.purple, 35), style=plot.style_linebr)

// =====================================================================
// SIGNALS — trend-aligned only (matches the backtested rules)
//   FADE  : tag a trend-aligned zone + >= kStretch sigma  (mean-reversion)
//   BREAK : close THROUGH a trend-aligned level, with trend (continuation)
// =====================================================================
fadeShort = bias < 0 and z1_res      and high >= z1_lo and close < z1_lo and stretch >=  kStretch
fadeLong  = bias > 0 and not z1_res   and low  <= z1_hi and close > z1_hi and stretch <= -kStretch
brkShort  = bias < 0 and ((not z2_res and close < z2_lo and close[1] >= z2_lo) or (not z3_res and close < z3_lo and close[1] >= z3_lo))
brkLong   = bias > 0 and ((z2_res     and close > z2_hi and close[1] <= z2_hi) or (z3_res     and close > z3_hi and close[1] <= z3_hi))

plotshape(fadeShort, "Fade short", shape.triangledown, location.abovebar, color.red,    size=size.small)
plotshape(fadeLong,  "Fade long",  shape.triangleup,   location.belowbar, color.green,  size=size.small)
plotshape(brkShort,  "Break short",shape.xcross,       location.belowbar, color.fuchsia,size=size.small)
plotshape(brkLong,   "Break long", shape.xcross,       location.abovebar, color.fuchsia,size=size.small)

alertcondition(fadeShort, "NQ FADE-short", "NQ FADE-short: zone tag + stretch (with trend)")
alertcondition(fadeLong,  "NQ FADE-long",  "NQ FADE-long: zone tag + stretch (with trend)")
alertcondition(brkShort,  "NQ BREAK-short","NQ BREAK-short: close thru support (with trend)")
alertcondition(brkLong,   "NQ BREAK-long", "NQ BREAK-long: close thru resistance (with trend)")

// ---- status table ----
var table t = table.new(position.top_right, 1, 3, border_width=1)
if barstate.islast
    bTxt = bias > 0 ? "Macro UP" : bias < 0 ? "Macro DOWN" : "Macro MIXED"
    bCol = bias > 0 ? color.green : bias < 0 ? color.red : color.gray
    table.cell(t, 0, 0, bTxt, text_color=color.white, bgcolor=bCol)
    table.cell(t, 0, 1, "Stretch " + str.tostring(stretch, "#.0") + "s", text_color=color.black, bgcolor = math.abs(stretch) >= kStretch ? color.yellow : color.silver)
    table.cell(t, 0, 2, "VWAP " + str.tostring(vwap, "#"), text_color=color.white, bgcolor=color.new(color.blue, 30))
