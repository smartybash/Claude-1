<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds L2Recorder.dll against the ATAS assemblies already on this machine
    and drops the result straight into the platform's Indicators folder.

    TargetFramework must match the .NET runtime the installed ATAS build uses.
    ATAS Platform 7.x ships on .NET 8, which is what this targets. ATAS X is a
    separate product on .NET 10 -- building against that install instead raises
    CS1705, so build.bat points at "ATAS Platform" explicitly.

    The ATAS install path is discovered from the usual locations. To point at a
    different one:  dotnet build -p:AtasDir="D:\Path\To\ATAS Platform"
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>L2Recorder</AssemblyName>
    <RootNamespace>Claude1.Recorders</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- ATAS supplies its own assemblies at runtime; shipping copies breaks loading. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    Where ATAS is installed. These run in order and each only fires if nothing
    earlier found it, so the first hit wins.
  -->
  <PropertyGroup Condition="'$(AtasDir)' == '' And Exists('$(LOCALAPPDATA)\ATAS Platform\ATAS.Indicators.dll')">
    <AtasDir>$(LOCALAPPDATA)\ATAS Platform</AtasDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AtasDir)' == '' And Exists('$(ProgramFiles)\ATAS Platform\ATAS.Indicators.dll')">
    <AtasDir>$(ProgramFiles)\ATAS Platform</AtasDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AtasDir)' == '' And Exists('$(ProgramW6432)\ATAS Platform\ATAS.Indicators.dll')">
    <AtasDir>$(ProgramW6432)\ATAS Platform</AtasDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AtasDir)' == '' And Exists('$(LOCALAPPDATA)\ATAS Platform\bin\ATAS.Indicators.dll')">
    <AtasDir>$(LOCALAPPDATA)\ATAS Platform\bin</AtasDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AtasDir)' == '' And Exists('$(USERPROFILE)\AppData\Roaming\ATAS Platform\ATAS.Indicators.dll')">
    <AtasDir>$(USERPROFILE)\AppData\Roaming\ATAS Platform</AtasDir>
  </PropertyGroup>

  <!-- Where the compiled indicator has to end up for ATAS to see it. -->
  <PropertyGroup Condition="'$(AtasIndicatorsDir)' == ''">
    <AtasIndicatorsDir>$(USERPROFILE)\Documents\ATAS\Indicators</AtasIndicatorsDir>
  </PropertyGroup>

  <Target Name="CheckAtasDir" BeforeTargets="BeforeBuild">
    <Error Condition="'$(AtasDir)' == ''"
           Text="Could not find ATAS.Indicators.dll in any of the usual install folders. Search your drive for ATAS.Indicators.dll, then rebuild from this folder with:  dotnet build -c Release -p:AtasDir=&quot;C:\Your\Path\ATAS Platform&quot;" />
    <Message Importance="high" Text="ATAS assemblies: $(AtasDir)" />
  </Target>

  <!--
    Reference every ATAS, OFT and Utils assembly in the install folder rather
    than naming a handful: the split between ATAS.Indicators,
    ATAS.DataFeedsCore, OFT.* and Utils.* has moved between platform versions,
    and referencing all of them costs nothing because none are copied.
  -->
  <ItemGroup Condition="'$(AtasDir)' != ''">
    <Reference Include="$(AtasDir)\ATAS.*.dll" Private="false" />
    <Reference Include="$(AtasDir)\OFT.*.dll" Private="false" />
    <Reference Include="$(AtasDir)\Utils.*.dll" Private="false" />
  </ItemGroup>

  <Target Name="InstallToAtas" AfterTargets="Build">
    <MakeDir Directories="$(AtasIndicatorsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AtasIndicatorsDir)"
          ContinueOnError="true" />
    <Message Importance="high"
             Text="Installed $(TargetFileName) to $(AtasIndicatorsDir)" />
  </Target>

</Project>
