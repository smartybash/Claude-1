<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds L2Recorder.dll against the ATAS assemblies already on this machine
    and drops the result straight into the platform's Indicators folder.

    TargetFramework must match the .NET runtime the installed ATAS build uses.
    ATAS 7.x ships on .NET 8; newer builds moved to .NET 10. If the build fails
    with framework or assembly-version errors, change the value below to
    net10.0-windows and rebuild -- that is the whole fix.

    The ATAS install path is discovered from the usual locations. To point at a
    different one:  dotnet build -p:AtasDir="D:\Path\To\ATAS Platform"
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>L2Recorder</AssemblyName>
    <RootNamespace>Claude1.Recorders</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- ATAS supplies these at runtime; shipping our own copies breaks loading. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Where ATAS is installed. First hit wins. -->
  <Choose>
    <When Condition="'$(AtasDir)' != ''" />
    <When Condition="Exists('$(LOCALAPPDATA)\ATAS Platform\ATAS.Indicators.dll')">
      <PropertyGroup><AtasDir>$(LOCALAPPDATA)\ATAS Platform</AtasDir></PropertyGroup>
    </When>
    <When Condition="Exists('$(ProgramFiles)\ATAS Platform\ATAS.Indicators.dll')">
      <PropertyGroup><AtasDir>$(ProgramFiles)\ATAS Platform</AtasDir></PropertyGroup>
    </When>
    <When Condition="Exists('$(ProgramW6432)\ATAS Platform\ATAS.Indicators.dll')">
      <PropertyGroup><AtasDir>$(ProgramW6432)\ATAS Platform</AtasDir></PropertyGroup>
    </When>
    <When Condition="Exists('$(LOCALAPPDATA)\ATAS Platform\bin\ATAS.Indicators.dll')">
      <PropertyGroup><AtasDir>$(LOCALAPPDATA)\ATAS Platform\bin</AtasDir></PropertyGroup>
    </When>
  </Choose>

  <!-- Where the compiled indicator has to end up for ATAS to see it. -->
  <PropertyGroup Condition="'$(AtasIndicatorsDir)' == ''">
    <AtasIndicatorsDir>$(USERPROFILE)\Documents\ATAS\Indicators</AtasIndicatorsDir>
  </PropertyGroup>

  <Target Name="CheckAtasDir" BeforeTargets="BeforeBuild">
    <Error Condition="'$(AtasDir)' == '' Or !Exists('$(AtasDir)\ATAS.Indicators.dll')"
           Text="Could not find ATAS.Indicators.dll. Locate your ATAS install folder (the one containing ATAS.Indicators.dll) and rebuild with:  dotnet build -p:AtasDir=&quot;C:\Your\Path\ATAS Platform&quot;" />
    <Message Importance="high" Text="ATAS assemblies: $(AtasDir)" />
  </Target>

  <!--
    Reference every ATAS/OFT/Utils assembly in the install folder rather than
    naming four of them: the exact split between ATAS.Indicators,
    ATAS.DataFeedsCore, OFT.* and Utils.Common has moved between versions, and
    referencing the lot costs nothing because none of them are copied.
  -->
  <ItemGroup>
    <Reference Include="$(AtasDir)\ATAS.*.dll" Private="false" />
    <Reference Include="$(AtasDir)\OFT.*.dll" Private="false" />
    <Reference Include="$(AtasDir)\Utils.*.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\*.cs" />
    <Compile Include="L2Recorder.cs" />
  </ItemGroup>

  <Target Name="InstallToAtas" AfterTargets="Build">
    <MakeDir Directories="$(AtasIndicatorsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AtasIndicatorsDir)"
          ContinueOnError="true" />
    <Message Importance="high"
             Text="Installed $(TargetFileName) -> $(AtasIndicatorsDir)" />
  </Target>

</Project>
